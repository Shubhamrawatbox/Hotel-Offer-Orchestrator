  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health - all dependencies",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns a health report', function () {",
                  "    pm.expect([200, 503]).to.include(pm.response.code);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('reports an overall status', function () {",
                  "    pm.expect(body.status).to.be.oneOf(['ok', 'degraded', 'down']);",
                  "});",
                  "",
                  "pm.test('reports both suppliers individually', function () {",
                  "    pm.expect(body.checks).to.have.property('supplierA');",
                  "    pm.expect(body.checks).to.have.property('supplierB');",
                  "    pm.expect(body.checks.supplierA.status).to.be.oneOf(['up', 'down']);",
                  "    pm.expect(body.checks.supplierB.status).to.be.oneOf(['up', 'down']);",
                  "});",
                  "",
                  "pm.test('reports Redis and Temporal', function () {",
                  "    pm.expect(body.checks.redis.status).to.eql('up');",
                  "    pm.expect(body.checks.temporal.status).to.eql('up');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Aggregate health: Redis, Temporal and both suppliers. 200 for ok/degraded, 503 when the service cannot serve."
          },
          "response": []
        },
