      "name": "Supplier outage scenario",
      "item": [
        {
          "name": "1. Take Supplier A down",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Supplier A is marked down', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.supplier).to.eql('A');",
                  "    pm.expect(body.down).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"down\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/suppliers/A/outage",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "suppliers", "A", "outage"]
            },
            "description": "Flips a sticky outage flag (stored in Redis) so the API and the worker both see it."
