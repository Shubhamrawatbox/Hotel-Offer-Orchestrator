          "name": "Supplier A - delhi",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 200', function () { pm.response.to.have.status(200); });",
                  "",
                  "const hotels = pm.response.json();",
                  "",
                  "pm.test('returns a non-empty array of hotels', function () {",
                  "    pm.expect(hotels).to.be.an('array').that.is.not.empty;",
                  "});",
                  "",
                  "pm.test('every hotel has the supplier contract shape', function () {",
                  "    hotels.forEach(function (hotel) {",
                  "        pm.expect(hotel).to.have.all.keys('hotelId', 'name', 'price', 'city', 'commissionPct');",
                  "        pm.expect(hotel.city).to.eql('delhi');",
                  "        pm.expect(hotel.price).to.be.a('number').and.to.be.above(0);",
                  "    });",
                  "});",
                  "",
                  "pm.collectionVariables.set('supplierANames', JSON.stringify(hotels.map(function (h) { return h.name; })));"
                ]
              }
            }
          ],
