    {
      "name": "Hotels",
      "item": [
        {
          "name": "Hotels - delhi (happy path)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 200', function () { pm.response.to.have.status(200); });",
                  "",
                  "const offers = pm.response.json();",
                  "",
                  "pm.test('returns a bare array of offers', function () {",
                  "    pm.expect(offers).to.be.an('array').that.is.not.empty;",
                  "});",
                  "",
                  "pm.test('each offer matches the documented response shape', function () {",
                  "    offers.forEach(function (offer) {",
                  "        pm.expect(offer).to.have.all.keys('name', 'price', 'supplier', 'commissionPct');",
                  "        pm.expect(offer.supplier).to.be.oneOf(['Supplier A', 'Supplier B']);",
                  "    });",
                  "});",
                  "",
                  "pm.test('hotel names are deduplicated', function () {",
                  "    const names = offers.map(function (o) { return o.name.toLowerCase(); });",
                  "    pm.expect(new Set(names).size).to.eql(names.length);",
                  "});",
                  "",
                  "pm.test('offers are sorted by ascending price', function () {",
                  "    const prices = offers.map(function (o) { return o.price; });",
                  "    pm.expect(prices).to.eql(prices.slice().sort(function (a, b) { return a - b; }));",
                  "});",
                  "",
                  "pm.test('the cheaper supplier wins for an overlapping hotel', function () {",
                  "    const holtin = offers.find(function (o) { return o.name === 'Holtin'; });",
                  "    pm.expect(holtin, 'Holtin should be present').to.exist;",
                  "    // Supplier A quotes 6000, Supplier B quotes 5340.",
                  "    pm.expect(holtin.supplier).to.eql('Supplier B');",
                  "    pm.expect(holtin.price).to.eql(5340);",
                  "",
                  "    const radison = offers.find(function (o) { return o.name === 'Radison'; });",
                  "    pm.expect(radison, 'Radison should be present').to.exist;",
                  "    // Supplier A quotes 5900, Supplier B quotes 6100.",
                  "    pm.expect(radison.supplier).to.eql('Supplier A');",
                  "    pm.expect(radison.price).to.eql(5900);",
                  "});",
                  "",
                  "pm.test('a hotel sold by only one supplier is kept', function () {",
                  "    const onlyOnB = offers.find(function (o) { return o.name === 'Bloomrooms Janpath'; });",
                  "    pm.expect(onlyOnB, 'Bloomrooms Janpath is only sold by Supplier B').to.exist;",
                  "    pm.expect(onlyOnB.supplier).to.eql('Supplier B');",
                  "});",
                  "",
                  "pm.test('the run is traceable back to a Temporal workflow', function () {",
                  "    pm.expect(pm.response.headers.get('x-workflow-id')).to.be.a('string').and.to.include('hotel-offers:delhi');",
                  "    pm.expect(pm.response.headers.get('x-offers-source')).to.eql('suppliers');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=delhi",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotels"],
              "query": [{ "key": "city", "value": "delhi" }]
            },
            "description": "Runs the Temporal workflow: both suppliers in parallel, dedupe by name, cheapest offer wins."
          },
          "response": []
        },
        {
          "name": "Hotels - delhi filtered by price range",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 200', function () { pm.response.to.have.status(200); });",
                  "",
                  "const offers = pm.response.json();",
                  "const minPrice = 4000;",
                  "const maxPrice = 6000;",
                  "",
                  "pm.test('returns an array', function () { pm.expect(offers).to.be.an('array'); });",
                  "",
                  "pm.test('every offer falls inside the requested range', function () {",
                  "    offers.forEach(function (offer) {",
                  "        pm.expect(offer.price, offer.name).to.be.at.least(minPrice);",
                  "        pm.expect(offer.price, offer.name).to.be.at.most(maxPrice);",
                  "    });",
                  "});",
                  "",
                  "pm.test('the filter was applied by Redis', function () {",
                  "    pm.expect(pm.response.headers.get('x-offers-source')).to.eql('redis');",
                  "});",
                  "",
                  "pm.test('the filter narrowed the deduplicated list', function () {",
                  "    const totalBeforeFilter = Number(pm.response.headers.get('x-total-before-filter'));",
                  "    pm.expect(totalBeforeFilter).to.be.above(offers.length);",
                  "});",
                  "",
                  "pm.test('expected hotels are inside the window', function () {",
                  "    const names = offers.map(function (o) { return o.name; });",
                  "    pm.expect(names).to.include('Ibis Aerocity');",
                  "    pm.expect(names).to.include('Holtin');",
                  "    pm.expect(names).to.not.include('Taj Palace');",
                  "});"
                ]
              }
            }
          ],
