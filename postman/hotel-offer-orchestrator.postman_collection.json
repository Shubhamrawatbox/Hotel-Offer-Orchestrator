          "name": "3. Hotels still served from Supplier B",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('still returns 200 with partial data', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const offers = pm.response.json();",
                  "",
                  "pm.test('every offer now comes from Supplier B', function () {",
                  "    pm.expect(offers).to.be.an('array').that.is.not.empty;",
                  "    offers.forEach(function (offer) {",
                  "        pm.expect(offer.supplier, offer.name).to.eql('Supplier B');",
                  "    });",
                  "});",
                  "",
                  "pm.test('the response is flagged as degraded', function () {",
                  "    pm.expect(pm.response.headers.get('x-degraded')).to.eql('true');",
                  "    pm.expect(pm.response.headers.get('x-suppliers-failed')).to.eql('A');",
                  "    pm.expect(pm.response.headers.get('x-suppliers-succeeded')).to.eql('B');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=delhi",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotels"],
              "query": [{ "key": "city", "value": "delhi" }]
            },
            "description": "With one supplier down the workflow still returns whatever the surviving supplier offers."
          },
          "response": []
        },
        {
          "name": "4. Take Supplier B down as well",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Supplier B is marked down', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().down).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"down\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/suppliers/B/outage",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "suppliers", "B", "outage"]
            }
          },
          "response": []
        },
        {
          "name": "5. Both suppliers down returns 502",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('reports a bad gateway', function () {",
                  "    pm.response.to.have.status(502);",
                  "});",
                  "",
                  "pm.test('names the failure clearly', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.error.code).to.eql('ALL_SUPPLIERS_UNAVAILABLE');",
                  "    pm.expect(body.error.requestId).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=delhi",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotels"],
              "query": [{ "key": "city", "value": "delhi" }]
            }
          },
          "response": []
        },
        {
          "name": "6. Restore both suppliers",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Supplier A is back up', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().down).to.eql(false);",
                  "});",
                  "",
                  "// Restore Supplier B too, so the collection leaves the stack healthy.",
                  "// replaceIn resolves {{baseUrl}} through the full variable scope chain,",
                  "// so an environment override is honoured here as well.",
                  "pm.sendRequest({",
                  "    url: pm.variables.replaceIn('{{baseUrl}}') + '/admin/suppliers/B/outage',",
                  "    method: 'POST',",
                  "    header: { 'Content-Type': 'application/json' },",
                  "    body: { mode: 'raw', raw: JSON.stringify({ down: false }) }",
                  "}, function (err, res) {",
                  "    pm.test('Supplier B is back up', function () {",
                  "        pm.expect(err).to.be.null;",
                  "        pm.expect(res).to.have.property('code', 200);",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"down\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/suppliers/A/outage",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "suppliers", "A", "outage"]
            }
          },
          "response": []
        },
