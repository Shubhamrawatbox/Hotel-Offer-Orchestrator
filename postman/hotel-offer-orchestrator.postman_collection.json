          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/suppliers",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "suppliers"]
            }
          },
          "response": []
        }
      ]
    }
