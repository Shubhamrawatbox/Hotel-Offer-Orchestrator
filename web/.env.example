# Where the Vite dev server forwards API calls (/api, /health, /admin, /supplierA, /supplierB).
# Point it at whichever backend is running, e.g. http://localhost:3100 if you
# started Compose with API_PORT=3100.
API_PROXY_TARGET=http://localhost:3000

# Base URL of the Temporal Web UI, used for the "View workflow" links.
VITE_TEMPORAL_UI_URL=http://localhost:8080
