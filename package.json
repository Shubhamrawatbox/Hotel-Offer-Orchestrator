{
  "name": "hotel-offer-orchestrator",
  "version": "1.0.0",
  "private": true,
  "description": "Aggregates overlapping hotel offers from two suppliers, dedupes by hotel name and selects the best price per hotel. Orchestrated with Temporal, cached and price-filtered in Redis.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/api/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "start": "node dist/api/server.js",
    "start:api": "node dist/api/server.js",
    "start:worker": "node dist/temporal/worker.js",
    "dev:api": "ts-node-dev --respawn --transpile-only src/api/server.ts",
    "dev:worker": "ts-node-dev --respawn --transpile-only src/temporal/worker.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@temporalio/activity": "^1.24.0",
    "@temporalio/client": "^1.24.0",
    "@temporalio/common": "^1.24.0",
    "@temporalio/worker": "^1.24.0",
    "@temporalio/workflow": "^1.24.0",
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "pino": "^9.3.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.12",
    "pino-pretty": "^11.2.2",
    "rimraf": "^5.0.9",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
