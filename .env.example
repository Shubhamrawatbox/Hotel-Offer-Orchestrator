# ---------------------------------------------------------------------------
# Copy to .env for local (non-Docker) runs. docker-compose.yml sets its own
# values, so you do not need this file when running with Compose.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000

LOG_LEVEL=info
# Human-readable logs for local development (requires the pino-pretty dev dep).
LOG_PRETTY=true

REDIS_URL=redis://localhost:6379
# How long a deduplicated city list stays cached, in seconds.
CACHE_TTL_SECONDS=300

TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=hotel-offers
TEMPORAL_CONNECT_TIMEOUT_MS=10000
WORKFLOW_EXECUTION_TIMEOUT_MS=60000

# Where the worker reaches the (mock) supplier APIs.
SUPPLIER_A_URL=http://localhost:3000/supplierA/hotels
SUPPLIER_B_URL=http://localhost:3000/supplierB/hotels
SUPPLIER_TIMEOUT_MS=3000

# Failure / latency simulation for the mock suppliers.
SUPPLIER_A_DOWN=false
SUPPLIER_B_DOWN=false
SUPPLIER_A_LATENCY_MS=0
SUPPLIER_B_LATENCY_MS=0
# 0 keeps mock prices fixed so tests can assert exact values; try 15 for variety.
SUPPLIER_PRICE_JITTER_PCT=0

WORKER_MAX_CONCURRENT_ACTIVITIES=50

# Host port for the API container (container-internal port is always 3000).
# Only used by docker-compose.yml; override if 3000 is already taken.
API_PORT=3000
